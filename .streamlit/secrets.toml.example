# Copy to .streamlit/secrets.toml for a local run (git-ignored), or paste into the app's Settings > Secrets
# on share.streamlit.io. Never commit the real file.
password = "change-me"
# The Google Sheet's link, or just the long ID between /d/ and /edit.
sheet_id = "https://docs.google.com/spreadsheets/d/your-sheet-id/edit"
title = "Alpha10"

# Optional but recommended: a Google service account the Sheet is shared with. With it the Sheet can be
# Restricted (no "Anyone with the link") and viewer downloads can stay off. Copy the fields from the
# account's JSON key file; keep the \n line breaks inside private_key as they are.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
